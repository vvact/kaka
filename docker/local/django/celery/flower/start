#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail

log() {
    echo "[$(date +'%Y-%m-%dT%H:%M:%S%z')]: $*" >&2
}

# Wait for Redis to be ready
wait_for_redis() {
    local RETRIES=0
    local MAX_RETRIES=30
    until redis-cli -h redis ping >/dev/null 2>&1; do
        RETRIES=$((RETRIES+1))
        if [ $RETRIES -gt $MAX_RETRIES ]; then
            log "ERROR: Redis not available after $MAX_RETRIES attempts."
            exit 1
        fi
        log "Waiting for Redis to become available... Attempt $RETRIES/$MAX_RETRIES"
        sleep 2
    done
}

wait_for_redis
log "Redis is available."

# Wait for Celery workers
worker_ready() {
    if celery -A kaka inspect ping -t 5 | grep -q "pong"; then
        return 0
    else
        return 1
    fi
}

log "Waiting for Celery workers..."
MAX_ATTEMPTS=30
ATTEMPT=0

until worker_ready; do
    ATTEMPT=$((ATTEMPT+1))
    if [ $ATTEMPT -gt $MAX_ATTEMPTS ]; then
        log "ERROR: Celery workers failed to become available after $MAX_ATTEMPTS attempts."
        exit 1
    fi
    log "Attempt $ATTEMPT/$MAX_ATTEMPTS: Celery workers not available. Retrying..."
    sleep 2
done

log "Celery workers are ready!"

# Check broker connection
if celery -A kaka status 2>&1 | grep -q 'ERROR'; then
    log "ERROR: Could not connect to the broker. Check CELERY_BROKER_URL."
    celery -A kaka status
    exit 1
fi

log "Starting Flower..."
exec flower --app=kaka --broker="${CELERY_BROKER_URL}" "$@"
