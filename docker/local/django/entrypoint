#!/bin/bash
set -o errexit
set -o pipefail
set -o nounset

log() {
    echo "[$(date +'%Y-%m-%dT%H:%M:%S%z')]: $*" >&2
}

# -------------------------
# Check required environment variables
# -------------------------
: "${POSTGRES_DB:?POSTGRES_DB is not set}"
: "${POSTGRES_USER:?POSTGRES_USER is not set}"
: "${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is not set}"
: "${PG_HOST:?PG_HOST is not set}"
: "${PG_PORT:?PG_PORT is not set}"
: "${CELERY_BROKER_URL:?CELERY_BROKER_URL is not set}"

# -------------------------
# Wait for PostgreSQL
# -------------------------
postgres_ready() {
python << END
import sys
import psycopg2
try:
    psycopg2.connect(
        dbname="${POSTGRES_DB}",
        user="${POSTGRES_USER}",
        password="${POSTGRES_PASSWORD}",
        host="${PG_HOST}",
        port="${PG_PORT}"
    )
except psycopg2.OperationalError:
    sys.exit(-1)
sys.exit(0)
END
}

log "Waiting for PostgreSQL to become available..."
until postgres_ready; do
    log "PostgreSQL not ready yet. Retrying..."
    sleep 2
done
log "PostgreSQL is ready buda!"

# -------------------------
# Wait for Redis
# -------------------------
wait_for_redis() {
    local RETRIES=0
    local MAX_RETRIES=30
    until redis-cli -h redis ping >/dev/null 2>&1; do
        RETRIES=$((RETRIES+1))
        if [ $RETRIES -gt $MAX_RETRIES ]; then
            log "ERROR: Redis not available after $MAX_RETRIES attempts."
            exit 1
        fi
        log "Waiting for Redis... Attempt $RETRIES/$MAX_RETRIES"
        sleep 2
    done
}

wait_for_redis
log "Redis is available!"

# -------------------------
# Wait for Celery workers (only if starting Flower)
# -------------------------
if [[ "$1" == "flower" ]]; then
    worker_ready() {
        if celery -A kaka inspect ping -t 5 | grep -q "pong"; then
            return 0
        else
            return 1
        fi
    }

    log "Waiting for Celery workers to become available..."
    MAX_ATTEMPTS=30
    ATTEMPT=0

    until worker_ready; do
        ATTEMPT=$((ATTEMPT+1))
        if [ $ATTEMPT -gt $MAX_ATTEMPTS ]; then
            log "ERROR: Celery workers failed to become available after $MAX_ATTEMPTS attempts."
            exit 1
        fi
        log "Attempt $ATTEMPT/$MAX_ATTEMPTS: Celery workers not available. Retrying..."
        sleep 2
    done
    log "Celery workers are ready!"
fi

# -------------------------
# Start the final command
# -------------------------
log "Starting $* ..."
exec "$@"
